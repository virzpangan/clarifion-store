<script>
window.themeIdle = window.themeIdle || function (fn, timeout) {
  timeout = timeout || 4000;
  if ('requestIdleCallback' in window) {
    requestIdleCallback(fn, { timeout: timeout });
  } else if (document.readyState === 'complete') {
    setTimeout(fn, 1);
  } else {
    window.addEventListener('load', function () { setTimeout(fn, 1); });
  }
};
</script>

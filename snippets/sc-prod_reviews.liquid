<link rel="stylesheet" href="{{ 'slick-theme.css' | asset_url }}" media="print" onload="this.onload=null;this.media='all'">
<noscript>{{ 'slick-theme.css' | asset_url | stylesheet_tag }}</noscript>
{% if content.review != blank %}
<div class="sc-prod_reviews">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="title-wrapper">
                    <h3>{{ content.review.title }}</h3>
                    <p>{{ content.review.desc}}</p>
                </div>
                <div class="prod-review-slider">
                    {% for item in content.review.list %}
                    <div>
                        <div class="wrapper">
                            <div class="content text-center">
                                <img src="https://cdn.shopify.com/s/files/1/0268/0638/6772/files/5-star.svg?v=1685411986" alt="">
                                <p>{{ item.quote }}</p>
                            </div>
                            <div class="bottom">
                                <ul>
                                    <li>{{ item.author }} - <span>Verified Buyer</span></li>
                                    <li>{{ item.product }}</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
      function initReviews() {
        if (!window.jQuery || !jQuery.fn.slick) {
          setTimeout(initReviews, 50);
          return;
        }
        jQuery('.prod-review-slider').slick({
            autoplay: true,
            autoplaySpeed: 5000,
            arrows: true,
            dots: true,
            infinite: true,
            slidesToShow: 3,
            slidesToScroll: 1,
            centerMode: true,
            variableWidth: true,
            responsive: [
                {
                    breakpoint: 768,
                    settings: {
                        slidesToShow: 1,
                        slidesToScroll: 1,
                    }
                }
            ]
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReviews);
      } else {
        initReviews();
      }
    })();
</script>
{% endif %}
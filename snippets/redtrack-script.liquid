<!-- RedTrack Script Start -->
<script>
  (function () {
var mntnRtkCmpId = "6a2aa7e3b3257fb32ac76f0e";

var redtrackCampaignMap = {
  mntn: "6a2aa7e3b3257fb32ac76f0e",
  axon: "6a348bd8e5120fbd4bf17eb7",
  meta: "YOUR_META_REDTRACK_CAMPAIGN_ID",
  facebook: "YOUR_META_REDTRACK_CAMPAIGN_ID",
  fb: "YOUR_META_REDTRACK_CAMPAIGN_ID",
  google: "YOUR_GOOGLE_REDTRACK_CAMPAIGN_ID",
  googleads: "YOUR_GOOGLE_REDTRACK_CAMPAIGN_ID",
  gads: "YOUR_GOOGLE_REDTRACK_CAMPAIGN_ID"
};

function getRtkCmpIdFromUtmSource() {
  var rtkcmpid = mntnRtkCmpId;

  try {
    var storedUtmParams = localStorage.getItem("utm_params");

    if (!storedUtmParams) {
      return rtkcmpid;
    }

    var utmParams = JSON.parse(storedUtmParams);
    var utmSource = utmParams && utmParams.utm_source;

    if (!utmSource) {
      return rtkcmpid;
    }

    var normalizedSource = String(utmSource)
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]/g, "");

    if (redtrackCampaignMap[normalizedSource]) {
      rtkcmpid = redtrackCampaignMap[normalizedSource];
    }
  } catch (error) {
    // If localStorage or JSON parsing fails, use the MNTN default campaign ID
  }

  return rtkcmpid;
}

var rtkcmpid = getRtkCmpIdFromUtmSource();

    var preclickUrl = "https://trkt.clarifion.com/preclick";
    var pretrackUrl = "https://trkt.clarifion.com/pretrack.js?rtkcmpid=" + encodeURIComponent(rtkcmpid);

    var cartAttributeName = "clickid";
    var hiddenLinkId = "redtrack-preclick-link";

    function saveClickIdToCart(clickId) {
      if (!clickId) return;

      try {
        var existingClickId = localStorage.getItem(cartAttributeName);

        if (existingClickId === clickId) {
          return;
        }

        localStorage.setItem(cartAttributeName, clickId);
      } catch (error) {
        // localStorage may be unavailable in some browsers
      }

      var formData = new FormData();
      formData.append("attributes[" + cartAttributeName + "]", clickId);

      fetch("/cart/update.js", {
        method: "POST",
        body: formData,
        credentials: "same-origin"
      }).catch(function () {
        // Do not block storefront behavior if the cart update fails
      });
    }

    function getClickIdFromElement(element) {
      if (!element) return null;

      var directClickId =
        element.getAttribute("clickid") ||
        element.getAttribute("data-clickid") ||
        element.getAttribute("rtkclickid") ||
        element.getAttribute("rtk-clickid") ||
        element.dataset.clickid ||
        null;

      if (directClickId) {
        return directClickId;
      }

      var href = element.getAttribute("href");

      if (!href) {
        return null;
      }

      try {
        var url = new URL(href, window.location.origin);
        return url.searchParams.get("clickid");
      } catch (error) {
        var match = href.match(/[?&]clickid=([^&]+)/);
        return match ? decodeURIComponent(match[1]) : null;
      }
    }

    function createHiddenPreclickLink() {
      var existingLink = document.getElementById(hiddenLinkId);

      if (existingLink) {
        return existingLink;
      }

      var link = document.createElement("a");

      link.id = hiddenLinkId;
      link.href = preclickUrl;
      link.style.display = "none";
      link.setAttribute("aria-hidden", "true");
      link.setAttribute("tabindex", "-1");
      link.setAttribute("rel", "nofollow noopener");
      link.textContent = "RedTrack Preclick";

      document.body.appendChild(link);

      return link;
    }

    function watchForClickId(link) {
      var existingClickId = getClickIdFromElement(link);

      if (existingClickId) {
        saveClickIdToCart(existingClickId);
      }

      var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
          if (
            mutation.type === "attributes" &&
            ["href", "clickid", "data-clickid", "rtkclickid", "rtk-clickid"].indexOf(mutation.attributeName) !== -1
          ) {
            var clickId = getClickIdFromElement(link);

            if (clickId) {
              saveClickIdToCart(clickId);
            }
          }
        });
      });

      observer.observe(link, {
        attributes: true,
        attributeFilter: ["href", "clickid", "data-clickid", "rtkclickid", "rtk-clickid"]
      });
    }

    function loadRedtrackScript() {
      var existingScript = document.querySelector('script[src*="trkt.clarifion.com/pretrack.js"]');

      if (existingScript) {
        return;
      }

      var script = document.createElement("script");

      script.type = "text/javascript";
      script.src = pretrackUrl;
      script.defer = true;

      document.head.appendChild(script);
    }

    function initRedtrack() {
      var link = createHiddenPreclickLink();

      watchForClickId(link);

      loadRedtrackScript();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initRedtrack);
    } else {
      initRedtrack();
    }
  })();
</script>
<!-- RedTrack Script End -->

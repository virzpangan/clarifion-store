{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign review_rating = false -%}
{%- assign review_count = 0 -%}

{%- comment -%}
  Reviews.io writes aggregate rating data to Shopify's standard `reviews` namespace
  (reviews.rating + reviews.rating_count), server-side rendered so crawlers see it
  without JS. See https://support.reviews.io/en/articles/9184882-shopify-metafields
  Gated on metafield presence rather than settings.enable_product_reviews, which also
  toggles the unused legacy Shopify Product Reviews (spr) widgets.
{%- endcomment -%}
{%- assign reviews_rating_count = product.metafields.reviews.rating_count.value | plus: 0 -%}
{%- if product.metafields.reviews.rating.value != blank and reviews_rating_count > 0 -%}
  {%- assign review_rating = product.metafields.reviews.rating.value -%}
  {%- assign review_count = reviews_rating_count -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "offers": {
      "@type": "Offer",
      "availability":"https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": "{{ current_variant.price | divided_by: 100.00 }}",
      "priceCurrency": "{{ shop.currency }}",
      "url": "{{ shop.url }}{{ product.url }}"
    },
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | json }}
    },
    {% if settings.sku_enable %}{% if current_variant.sku %}"sku": "{{ current_variant.sku }}",{% endif %}{% endif %}
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | json }},
    {%- if product.type != blank -%}
    "category": {{ product.type | json }},
    {%- endif %}
    "url": "{{ shop.url }}{{ product.url }}",
    {% if review_rating and review_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ review_rating }}",
      "reviewCount": "{{ review_count }}",
      "bestRating": "5",
      "worstRating": "1"
    },
    {% endif %}
    "image": {
      "@type": "ImageObject",
      "url": "https:{{ product.featured_image.src | img_url: '1024x1024' }}",
      "image": "https:{{ product.featured_image.src | img_url: '1024x1024' }}",
      "name": {{ product.title | json }},
      "width": 1024,
      "height": 1024
    }
  }
</script>

{%- assign product_thumb_size = '180x' -%}
{%- assign product_zoom_size = '1800x1800' -%}
{%- assign product_image_size = '620x' -%}

{% case image_container_width %}
  {% when 'small' %}
    {%- assign product_image_width = 'medium-up--two-fifths' -%}
    {%- assign product_description_width = 'medium-up--three-fifths' -%}
    {%- assign product_image_size = '480x' -%}
  {% when 'medium' %}
    {%- assign product_image_width = 'medium-up--one-half' -%}
    {%- assign product_description_width = 'medium-up--one-half' -%}
    {%- assign product_image_size = '620x' -%}
  {% when 'large' %}
    {%- assign product_image_width = 'medium-up--three-fifths' -%}
    {%- assign product_description_width = 'medium-up--two-fifths' -%}
    {%- assign product_image_size = '740x' -%}
{% endcase %}

{% liquid
  assign lpv_value = blank
  assign current_slug_path = blank

  if product
    assign current_slug_path = 'products-' | append: product.handle | replace: '-', '_'
  elsif collection
    assign current_slug_path = 'collections-' | append: collection.handle | replace: '-', '_'
  elsif page
    assign current_slug_path = 'pages-' | append: page.handle | replace: '-', '_'
  elsif article
    assign article_handle = article.handle | replace: '-', '_'
    assign blog_handle = blog.handle | replace: '-', '_'
    assign current_slug_path = 'blogs-' | append: blog_handle | append: '-' | append: article_handle
  elsif blog
    assign blog_handle = blog.handle | replace: '-', '_'
    assign current_slug_path = 'blogs-' | append: blog_handle
  else
    assign current_slug_path = request.path | remove_first: '/' | replace: '/', '-' | replace: '-', '_'
  endif

assign lpv_value = current_slug_path
%}


{% if lpv_value != blank %}
  <script>
    (function () {
      var lpvValue = {{ lpv_value | json }};
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'lpv', lpv: lpvValue });
      document.cookie = 'lpv=' + encodeURIComponent(lpvValue) + '; path=/; max-age=1800; SameSite=Lax';
    })();
  </script>
{% endif %}

}

  @keyframes scFadeUp {
    from {
      opacity: 0;
      transform: translateY(26px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fd-banner.xs{display:none!important;}


/* Video slide with poster fallback */
.slider-bg.video-slide {
  position: relative;
  overflow: hidden;
  background: #000;
}

.video-poster {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-image: url('https://cdn.shopify.com/s/files/1/0268/0638/6772/files/clf-ctv-poster.webp?v=1781663592');
  background-size: cover;
  background-position: center;
  transition: opacity 0.45s ease, visibility 0.45s ease;
}

.slider-bg.video-slide video {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.slider-bg.video-slide.video-ready .video-poster {
  opacity: 0;
  visibility: hidden;
}

.slider-bg.video-slide .container {
  position: relative;
  z-index: 2;
}

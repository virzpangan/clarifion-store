  .sc-banner-slider .slick-slide::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }


  {% comment %} .sc-banner-slider .slick-slide:nth-child(1)::before{
    background:none!important;
  } {% endcomment %}

  .sc-banner-slider .slick-slide img {
    position: relative;
    z-index: 0;
  }

  .sc-banner-slider .slick-slide .slider-bg .row {
    position: relative;
    z-index: 2;
  }

  .sc-banner-slider .slick-slide::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(0, 28, 113, 0.78) 0%,
      rgba(0, 28, 113, 0.55) 45%,
      rgba(26, 152, 255, 0.22) 100%
    );
    pointer-events: none;
  }

  .sc-banner-slider {
    position: relative;
    overflow: hidden;
  }

  .sc-banner-slider .slick-slide {
    position: relative;
    overflow: hidden;
  }

  .sc-banner-slider .slick-slide img {
    width: 100%;
    display: block;
    transform: scale(1.08);
    transition: transform 6s ease;
  }

  .sc-banner-slider .slick-active img {
    transform: scale(1);
  }

  /* Optional: animate banner text/content */
  .sc-banner-slider .slick-slide .banner-content {
    opacity: 0;
    transform: translateY(35px);
    transition: opacity 0.9s ease, transform 0.9s ease;
  }

  .sc-banner-slider .slick-active .banner-content {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.35s;
  }

  /* Premium arrows */
  .sc-slider-arrow {
    position: absolute;
    top: 50%;
    z-index: 5;
    width: 54px;
    height: 54px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transform: translateY(-50%);
    transition: all 0.35s ease;
  }

  .sc-slider-arrow:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.75);
    transform: translateY(-50%) scale(1.08);
  }

  .sc-slider-prev {
    left: 32px;
  }

  .sc-slider-next {
    right: 32px;
  }

  .sc-slider-arrow span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 13px;
    border-top: 2px solid #fff;
    border-right: 2px solid #fff;
  }

  .sc-slider-prev span {
    transform: translate(-35%, -50%) rotate(-135deg);
  }

  .sc-slider-next span {
    transform: translate(-65%, -50%) rotate(45deg);
  }

  /* Premium dots */
  .sc-banner-slider .slick-dots {
    bottom: 30px;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .sc-banner-slider .slick-dots li {
    width: auto;
    height: auto;
    margin: 0;
  }

  .sc-banner-slider .slick-dots button {
    width: 34px;
    height: 4px;
    padding: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    transition: all 0.35s ease;
  }

  .sc-banner-slider .slick-dots button:before {
    display: none;
  }

  .sc-banner-slider .slick-dots .slick-active button {
    width: 54px;
    background: #fff;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .sc-slider-arrow {
      width: 42px;
      height: 42px;
    }

    .sc-slider-prev {
      left: 14px;
    }

    .sc-slider-next {
      right: 14px;
    }

    .sc-banner-slider .slick-dots {
      bottom: 18px;
    }

    .sc-banner-slider .slick-dots button {
      width: 24px;
    }

    .sc-banner-slider .slick-dots .slick-active button {
      width: 38px;
    }
   
  }

  .sc-banner-content {
    position: relative;
    z-index: 2;
    margin: 0 auto;
    padding: 120px 20px;
    color: #fff;
  }

  .sc-banner-kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    padding: 9px 18px;
    border: 1px solid rgba(26, 152, 255, 0.45);
    border-radius: 999px;
    background: rgba(0, 28, 113, 0.42);
    backdrop-filter: blur(12px);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 12px 30px rgba(0, 28, 113, 0.28);
  }

  .sc-banner-content h2 {
    margin: 0 auto 18px;
    color: #ffffff;
    font-size: clamp(42px, 6vw, 82px);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
    text-shadow: 0 18px 40px rgba(0, 28, 113, 0.45);
  }

  .sc-banner-content p {
    max-width: 768px;
    margin: 0 auto 34px;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.65;
  }

  .sc-banner-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 170px;
    justify-content: center;
    padding: 16px 28px;
    border-radius: 999px;
    background: #1a98ff;
    color: #ffffff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 18px 42px rgba(26, 152, 255, 0.35);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .sc-banner-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -85%;
    width: 70%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.42), transparent);
    transform: skewX(-22deg);
    transition: left 0.65s ease;
  }

  .sc-banner-btn:hover {
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-4px);
    box-shadow: 0 24px 55px rgba(26, 152, 255, 0.48);
  }

  .sc-banner-btn:hover::before {
    left: 120%;
  }

  .sc-banner-btn span {
    width: 9px;
    height: 9px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.35s ease;
  }

  .sc-banner-btn:hover span {
    transform: translateX(4px) rotate(45deg);
  }

  .sc-banner-slider .sc-banner-content {
    opacity: 0;
    transform: translateY(36px) scale(0.98);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sc-banner-slider .slick-active .sc-banner-content {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .sc-banner-slider .slick-active .sc-banner-kicker {
    animation: scFadeUp 0.8s ease both 0.15s;
  }

  .sc-banner-slider .slick-active h2 {
    animation: scFadeUp 0.9s ease both 0.3s;
  }

  .sc-banner-slider .slick-active .coupon-banner{
      animation: scFadeUp 0.9s ease both 0.45s;
  }

  .sc-banner-slider .slick-active p {
    animation: scFadeUp 0.9s ease both 0.6s;
  }

  .sc-banner-slider .slick-active .sc-banner-btn {
    animation: scFadeUp 0.9s ease both 0.7s;
  }

  .coupon-banner {
  display: inline-flex;

{% if content.alternate != blank %}
<div class="sc-prod_alternate">
    <div class="container">
        {% for item in content.alternate %}
        {% assign mod = forloop.index | modulo: 2 %}
        {% if mod == 0 %}
        <div class="row flow-reverse">
            <div class="col-md-6 text-center">
                <img src="{{ item.image }}" alt="">
            </div>
            <div class="col-md-6 d-flex align-items-center">
                <div class="wrapper">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.desc }}</p>
                </div>
            </div>
        </div>
        {% else %}
        <div class="row">
            <div class="col-md-6 d-flex align-items-center">
                <div class="wrapper">
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.desc }}</p>
                </div>
            </div>
            <div class="col-md-6 text-center">
                <img src="{{ item.image }}" alt="">
            </div>
        </div>
        {% endif %}
        {% endfor %}
    </div>
</div>
{% endif %}